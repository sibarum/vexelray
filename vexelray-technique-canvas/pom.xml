<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray</groupId>
        <artifactId>vexelray</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vexelray-technique-canvas</artifactId>

    <description>
        The 2D canvas as a RenderTechnique: it owns the uber-shader pipeline, the vertex buffer, and the atlas,
        and records a Canvas batch into a frame the runtime began — so 2D chrome can share a frame with a marched
        scene instead of owning the window.

        A separate module from vexelray-canvas on purpose. Canvas itself is a pure geometry batcher with no
        Vulkan and no runtime: it builds a fat-vertex array and a list of runs, which is exactly what makes it
        testable headlessly and reusable by a different backend. Putting the technique here keeps that true, and
        matches the vexelray-technique-* convention the architecture uses for renderable kinds.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-canvas</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-engine-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- For VulkanTechniqueContext — the Vulkan-bearing subtype a technique casts to (D3). -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-vulkan</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test-only: the demos below open windows and need the platform provider at runtime. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-os-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vastir-tools</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>platform-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation>
                <os><family>unix</family><name>linux</name></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
