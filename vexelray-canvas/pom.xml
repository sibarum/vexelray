<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray</groupId>
        <artifactId>vexelray</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-canvas</artifactId>

    <description>
        The 2D Canvas API: an immediate-mode drawing surface that accumulates rounded rectangles, circles, lines,
        and text into one unified batch of "fat" vertices, drawn by a single uber-shader that branches per
        primitive kind (analytic rounded-box SDF for shapes, MSDF sampling for glyphs). Binding-agnostic — it
        produces vertex data and the shader IR; the Vulkan module supplies the pipeline, atlas image, and target
        (framebuffer or offscreen texture).
    </description>

    <dependencies>
        <!-- Text layout + MSDF atlas model + glyph quads (Canvas.text delegates to TextLayout). -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-text</artifactId>
        </dependency>
        <!-- Shader composition to SPIR-V. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-shader</artifactId>
        </dependency>
        <!-- SupirVast core IR for the uber-shader. -->
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vastir</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Pre-compile the uber-shader (CanvasShader.Vertex / .Fragment) to SPIR-V at build time. The binaries
              ship in the jar as META-INF/supirvast/shaders/canvas.{vert,frag}.spv, and CanvasShader.vertex() /
              fragment() load them via Shaders.loadOrLower — so at runtime, pipeline creation is a resource read
              and CoreToSpirv never runs. That takes shader lowering off the startup path (which lives on the main
              thread by design) without moving any work to another thread.
            -->
            <plugin>
                <groupId>dev.supirvast</groupId>
                <artifactId>supirvast-maven-plugin</artifactId>
                <version>${supirvast.version}</version>
                <executions>
                    <execution>
                        <id>precompile-shaders</id>
                        <goals>
                            <goal>compile-shaders</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
