<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray</groupId>
        <artifactId>vexelray</artifactId>
        <version>0.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-trace-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <description>
        The trace-site weaver (docs/trace.md): after javac, rewrites every @Trace method to begin with a guarded call
        into vexelray-trace, checks what its args name, and generates the module's TraceSites table. On the JDK's
        ClassFile API (java.lang.classfile), with no dependencies of its own; so it targets JDK 25, unlike
        vexelray-msdf-maven-plugin, and the descriptor scanner below is given an ASM that reads JDK 25 classes.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- The runtime the woven code calls, and the probe it writes through: for the tests, which weave fixtures
             and run them. The weaver itself names those classes only as strings. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-trace</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-plugin.version}</version>
                <!-- 3.15.1 scans with ASM 9.7.1, which cannot read a JDK 25 class; 9.8 and later can. -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.9.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.9.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-tree</artifactId>
                        <version>9.9.1</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The default run: the probe off, so a woven method runs and writes nothing. -->
                    <excludes>
                        <exclude>**/TracedRunTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Whether the probe is on is decided once, in a static initialiser, so the run that reads its
                         own trace rows back needs a JVM started recording. -->
                    <execution>
                        <id>traced</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <probe>trace,app</probe>
                                <probe.format>csv</probe.format>
                                <probe.out>${project.build.directory}/trace-run.csv</probe.out>
                            </systemPropertyVariables>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/TracedRunTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
