<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray</groupId>
        <artifactId>vexelray</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-text</artifactId>

    <description>
        MSDF text rendering: the msdf-atlas-gen atlas model (JSON metadata + records), a glyph-layout that turns a
        string into screen-space quads, and the MSDF sampling shader authored as SupirVast core IR. Binding-agnostic
        — it produces geometry (quads / vertex arrays) and SPIR-V; the Vulkan module supplies the sampled image,
        sampler, descriptor set, and vertex buffer that draw it. The atlas artifacts are generated by
        vexelray-msdf-maven-plugin and committed under resources.
    </description>

    <dependencies>
        <!-- Shader composition: engine IR -> SupirVast core IR -> SPIR-V (ComposedShader). -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-shader</artifactId>
        </dependency>
        <!-- SupirVast core IR for authoring the MSDF vertex + fragment shaders. -->
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vastir</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Regenerate the committed MSDF atlas from the bundled font at build time (generate-resources), the
              way Dasum's dasum-files does. Default mode 'primary' runs the bundled msdf-atlas-gen (Windows) and is
              incremental — it only re-runs when the font is newer than the outputs. On non-Windows, build with
              -Dmsdf.mode=prebuilt to consume the committed primary.png/json instead of regenerating.
            -->
            <plugin>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-msdf-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate-atlases</id>
                        <goals>
                            <goal>generate-atlas</goal>
                        </goals>
                        <configuration>
                            <outputDir>${project.basedir}/src/main/resources/dev/vexelray/text/atlas</outputDir>
                            <atlases>
                                <atlas>
                                    <name>primary</name>
                                    <font>${project.basedir}/fonts/NotoSans-Regular.ttf</font>
                                    <charset>ascii</charset>
                                    <atlasSize>1024</atlasSize>
                                    <fontSize>32</fontSize>
                                    <pxRange>4</pxRange>
                                </atlas>
                            </atlases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
