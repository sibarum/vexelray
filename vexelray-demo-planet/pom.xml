<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray</groupId>
        <artifactId>vexelray</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vexelray-demo-planet</artifactId>

    <description>
        A full-scale procedural exoplanet, meant to be flown from orbit to the grass: terrain as analytic octaves
        whose bounds are proven rather than sampled, marched through shells that hold the coarse octaves, under a
        single-scattering atmosphere. Grows milestone by milestone (orbit, descent, ground detail, trees, the
        saucer); see the package javadoc.
    </description>

    <properties>
        <planet.mainClass>dev.vexelray.demo.planet.PlanetDemo</planet.mainClass>
        <!-- Program arguments for exec:exec: empty opens a window; "capture DIR" writes offscreen views. -->
        <planet.args></planet.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-vulkan</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The planet is a technique of its own, so it casts to VulkanTechniqueContext like any other. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-engine-vulkan-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ClipDepth, Lens and core IR lowering; brings vastir and vastir-tools (Fullscreen) transitively. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-shader</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn -pl vexelray-demo-planet -am compile exec:exec, as for Fathom (see vexelray-demo's pom). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${planet.mainClass}</argument>
                        <argument>${planet.args}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
